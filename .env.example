# 앱이 붙는 개발 서버 (Supabase 프로젝트 chagok-dev). .env.local에 복사해 채운다.
EXPO_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon 키>
# 개발용 로그인 (__DEV__ 화면에서만 쓴다). npm run server:dev-user로 만든다.
EXPO_PUBLIC_DEV_EMAIL=dev@chagok.test
EXPO_PUBLIC_DEV_PASSWORD=<직접 정한 비밀번호>

# 사용 기록 (PostHog). 비어 있거나 개발 빌드이면 보내지 않는다. 저장 지역은 독일로 정했다 (처리방침과 같은 값). 프로젝트도 EU Cloud에 만든다.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# 오류 수집 (Sentry). 비어 있거나 개발 빌드이면 보내지 않는다. 저장 지역은 독일로 정했다. 조직을 Frankfurt로 만들고 그 프로젝트의 DSN을 넣는다.
EXPO_PUBLIC_SENTRY_DSN=
# 출시 빌드의 소스맵 올리기에만 쓴다. EXPO_PUBLIC_를 붙이지 않는다 — 앱에 들어가면 안 되는 값이다. 토큰은 EAS 비밀값으로 넣는다.
SENTRY_URL=https://de.sentry.io/
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
