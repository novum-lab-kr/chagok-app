{
  "expo": {
    "name": "차곡차곡",
    "slug": "chagok",
    "owner": "novum-lab",
    "scheme": "chagok",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.novumlab.chagok",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "appleTeamId": "AJ7LJPM82M",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyAccessedAPITypes": [
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults", "NSPrivacyAccessedAPITypeReasons": ["CA92.1", "1C8F.1"] },
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp", "NSPrivacyAccessedAPITypeReasons": ["C617.1", "0A2A.1", "3B52.1"] },
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime", "NSPrivacyAccessedAPITypeReasons": ["35F9.1"] },
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace", "NSPrivacyAccessedAPITypeReasons": ["E174.1", "85F4.1"] }
        ]
      }
    },
    "android": {
      "package": "com.novumlab.chagok",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#AFE1CB"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "기록에 사진을 첨부할 때 사진 보관함에 접근합니다.",
          "cameraPermission": "기록에 남길 사진을 찍을 때 카메라를 사용합니다.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "@react-native-kakao/core",
        {
          "nativeAppKey": "eee7d607ec43b07774b8eff6056dacfe",
          "android": { "authCodeHandlerActivity": true },
          "ios": { "handleKakaoOpenUrl": true }
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        { "iosUrlScheme": "com.googleusercontent.apps.569281636863-jmu9re3f6u38ajadbpl97nccabmi8fh2" }
      ],
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#AFE1CB",
          "image": "./assets/splash-icon.png",
          "imageWidth": 168,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
        {
          "name": "ChagokGoal",
          "displayName": "목표 하나",
          "description": "목표 하나의 진행과 오늘 스티커",
          "android": null,
          "ios": {
            "supportedFamilies": ["systemSmall"],
            "contentMarginsDisabled": true,
            "configuration": {
              "title": "목표 하나",
              "parameters": {
                "background": {
                  "title": "바탕",
                  "type": "enum",
                  "default": "ivory",
                  "values": [
                    { "name": "아이보리", "value": "ivory" },
                    { "name": "흰색", "value": "white" },
                    { "name": "먹색", "value": "ink" }
                  ]
                }
              }
            }
          }
        },
        {
          "name": "ChagokMonth",
          "displayName": "이번 달",
          "description": "달력판 목표의 이번 달",
          "android": null,
          "ios": {
            "supportedFamilies": ["systemMedium"],
            "contentMarginsDisabled": true,
            "configuration": {
              "title": "이번 달",
              "parameters": {
                "background": {
                  "title": "바탕",
                  "type": "enum",
                  "default": "ivory",
                  "values": [
                    { "name": "아이보리", "value": "ivory" },
                    { "name": "흰색", "value": "white" },
                    { "name": "먹색", "value": "ink" }
                  ]
                }
              }
            }
          }
        },
        {
          "name": "ChagokTally",
          "displayName": "적립판",
          "description": "적립판 목표의 다음 10칸",
          "android": null,
          "ios": {
            "supportedFamilies": ["systemMedium"],
            "contentMarginsDisabled": true,
            "configuration": {
              "title": "적립판",
              "parameters": {
                "background": {
                  "title": "바탕",
                  "type": "enum",
                  "default": "ivory",
                  "values": [
                    { "name": "아이보리", "value": "ivory" },
                    { "name": "흰색", "value": "white" },
                    { "name": "먹색", "value": "ink" }
                  ]
                }
              }
            }
          }
        }
          ]
        }
      ],
      "./plugins/widget-goal",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3557389923784580~6730991421"
        }
      ],
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bb89bc84-8571-4191-a095-563d2e04e2d0"
      }
    }
  }
}
