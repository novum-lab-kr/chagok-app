{
  "expo": {
    "name": "차곡차곡",
    "slug": "chagok",
    "scheme": "chagok",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.eunjukim.chagok",
      "supportsTablet": false
    },
    "android": {
      "package": "com.eunjukim.chagok",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "기록에 사진을 첨부할 때 사진 보관함에 접근합니다.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
