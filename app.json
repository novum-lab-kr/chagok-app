{
  "expo": {
    "name": "차곡차곡",
    "slug": "chagok",
    "owner": "novum-lab",
    "scheme": "chagok",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.novum.chagok",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.novum.chagok",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#AFE1CB"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "기록에 사진을 첨부할 때 사진 보관함에 접근합니다.",
          "cameraPermission": "기록에 남길 사진을 찍을 때 카메라를 사용합니다.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#AFE1CB",
          "image": "./assets/splash-icon.png",
          "imageWidth": 168,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
        {
          "name": "ChagokGoal",
          "displayName": "목표 하나",
          "description": "목표 하나의 진행과 오늘 스티커",
          "android": null,
          "ios": {
            "supportedFamilies": ["systemSmall"],
            "contentMarginsDisabled": true,
            "configuration": {
              "title": "목표 하나",
              "parameters": {
                "background": {
                  "title": "바탕",
                  "type": "enum",
                  "default": "ivory",
                  "values": [
                    { "name": "아이보리", "value": "ivory" },
                    { "name": "흰색", "value": "white" },
                    { "name": "먹색", "value": "ink" }
                  ]
                }
              }
            }
          }
        },
        {
          "name": "ChagokMonth",
          "displayName": "이번 달",
          "description": "달력판 목표의 이번 달",
          "android": null,
          "ios": {
            "supportedFamilies": ["systemMedium"],
            "contentMarginsDisabled": true,
            "configuration": {
              "title": "이번 달",
              "parameters": {
                "background": {
                  "title": "바탕",
                  "type": "enum",
                  "default": "ivory",
                  "values": [
                    { "name": "아이보리", "value": "ivory" },
                    { "name": "흰색", "value": "white" },
                    { "name": "먹색", "value": "ink" }
                  ]
                }
              }
            }
          }
        },
        {
          "name": "ChagokTally",
          "displayName": "적립판",
          "description": "적립판 목표의 다음 10칸",
          "android": null,
          "ios": {
            "supportedFamilies": ["systemMedium"],
            "contentMarginsDisabled": true,
            "configuration": {
              "title": "적립판",
              "parameters": {
                "background": {
                  "title": "바탕",
                  "type": "enum",
                  "default": "ivory",
                  "values": [
                    { "name": "아이보리", "value": "ivory" },
                    { "name": "흰색", "value": "white" },
                    { "name": "먹색", "value": "ink" }
                  ]
                }
              }
            }
          }
        }
          ]
        }
      ],
      "./plugins/widget-goal"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bb89bc84-8571-4191-a095-563d2e04e2d0"
      }
    }
  }
}
