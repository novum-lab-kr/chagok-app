{
  "expo": {
    "name": "차곡차곡",
    "slug": "chagok",
    "owner": "novum-lab",
    "scheme": "chagok",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.novum.chagok",
      "supportsTablet": false
    },
    "android": {
      "package": "com.novum.chagok",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#AFE1CB"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "기록에 사진을 첨부할 때 사진 보관함에 접근합니다.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#AFE1CB",
          "image": "./assets/splash-icon.png",
          "imageWidth": 168,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bb89bc84-8571-4191-a095-563d2e04e2d0"
      }
    }
  }
}
